<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="#10251B">
    <TextView android:id="@+id/widget_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="READY" android:textColor="#A7E6B7" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_miles" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0.0 mi" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_elapsed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="00:00:00" android:textColor="#D6E5DB" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end">
        <Button android:id="@+id/widget_start" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Start" />
        <Button android:id="@+id/widget_stop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reset" />
    </LinearLayout>
</LinearLayout>
