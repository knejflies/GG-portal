{
  "id": "/admin/",
  "name": "Green Grin Admin Portal",
  "short_name": "GGL Admin",
  "description": "Owner dashboard for Green Grin Lawns.",
  "start_url": "/admin/",
  "scope": "/admin/",
  "display": "standalone",
  "background_color": "#f6f7f1",
  "theme_color": "#123324",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/assets/green-grin-pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/green-grin-pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Mileage Tracker",
      "short_name": "Mileage",
      "description": "Open the mileage tracker",
      "url": "/admin/?view=mileage",
      "icons": [
        {
          "src": "/assets/green-grin-pwa-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Start GPS Trip",
      "short_name": "GPS Trip",
      "description": "Start tracking a mileage trip",
      "url": "/admin/?view=mileage&track=1",
      "icons": [
        {
          "src": "/assets/green-grin-pwa-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
